{
  "name": "norma-ads-mcp",
  "version": "1.0.0",
  "description": "NORMA Agentic Ads MCP server — lets AI agents discover inventory, plan campaigns, execute buys, and pull performance data from NORMA's sports-bettor push notification marketplace.",
  "main": "dist/index.js",
  "bin": {
    "norma-ads-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "keywords": ["mcp", "advertising", "norma", "sports", "agents"],
  "license": "MIT"
}
