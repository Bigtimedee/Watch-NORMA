# --- Incoming gate: secret that AI agents must present as Bearer token to connect ---
NORMA_API_KEY=your-chosen-secret-here

# --- Outgoing auth: OAuth 2.0 client credentials for the NORMA REST API ---
# Create these at getnorma.app/settings (log in as an advertiser) → API Access → Create client
NORMA_OAUTH_CLIENT_ID=norma_client_xxxxxxxx
NORMA_OAUTH_CLIENT_SECRET=your-client-secret-here

# --- Optional overrides ---
# NORMA_API_BASE_URL=https://getnorma.app/api/ads
# PORT=3001
