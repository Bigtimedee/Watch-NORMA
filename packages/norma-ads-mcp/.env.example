# Required: NORMA platform API key (get from https://getnorma.app/developers)
NORMA_API_KEY=your_norma_api_key_here

# Optional: override the NORMA REST API base URL (default: https://getnorma.app/api/ads)
NORMA_API_BASE_URL=https://getnorma.app/api/ads

# Optional: HTTP server port (default: 3001, Railway sets this automatically)
PORT=3001
