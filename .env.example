EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SPORTSDATAIO_API_KEY=your-sportsdataio-key

# Screenshot / demo fixtures: required to even *consider* seeding demo-% rows.
# The seed preflight still refuses production (shijrazlzawjpobrpmnt).
# ALLOW_DEMO_SEED=1

# ---------------------------------------------------------------------------
# Edge Function secrets (set via `supabase secrets set`, not in the mobile bundle)
# LinkedIn company-page publishing — cmo-publish-linkedin
# ---------------------------------------------------------------------------
# Required. OAuth 2.0 access token with w_organization_social (Community
# Management API). Token is a 3-legged member token whose member is an admin
# of the NORMA company page. Do not commit a real token.
# LINKEDIN_ACCESS_TOKEN=
#
# Required. Numeric company page id, or full URN (urn:li:organization:12345).
# Must be the NORMA organization — never a person URN.
# LINKEDIN_ORGANIZATION_ID=
#
# Optional. Used only to refresh LINKEDIN_ACCESS_TOKEN on HTTP 401.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REFRESH_TOKEN=
#
# Optional. LinkedIn-Version header (YYYYMM). Defaults to 202506.
# LINKEDIN_API_VERSION=202506
