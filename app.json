{
  "expo": {
    "name": "NORMA",
    "slug": "norma",
    "version": "1.8.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3a418868-5bb5-4852-b565-3282ee4fe91e"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "norma",
    "splash": {
      "image": "./assets/norma-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.norma.app",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "buildNumber": "38",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:getnorma.app",
        "applinks:www.getnorma.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "NORMA needs access to your camera to scan bet slips.",
        "NSPhotoLibraryUsageDescription": "NORMA needs access to your photo library to scan bet slip screenshots.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "sportscenter",
          "paramountplus",
          "peacocktv",
          "hbomax",
          "hulu",
          "youtube-tv",
          "youtubetv",
          "fubo",
          "slingtv",
          "directvstream",
          "draftkings",
          "fanduel",
          "betmgm",
          "caesarssportsbook",
          "kalshi",
          "tntdrama",
          "tbs",
          "trutv",
          "cbssports",
          "xfinitystream",
          "spectrumtv",
          "mlbatbat",
          "foxsports",
          "aiv",
          "nflx",
          "videos",
          "nfl",
          "nba",
          "nhl",
          "dazn",
          "prizepicks",
          "underdog",
          "sleeper",
          "yahoosports",
          "youtube"
        ]
      }
    },
    "android": {
      "package": "com.norma.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "getnorma.app",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "getnorma.app",
              "pathPrefix": "/games/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.getnorma.app",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "www.getnorma.app",
              "pathPrefix": "/games/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "./plugins/withRCTAppDelegateModularHeaders",
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f97316",
          "defaultChannel": "game-alerts"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NORMA needs access to your photo library to scan bet slip screenshots.",
          "cameraPermission": "NORMA needs access to your camera to scan bet slips.",
          "microphonePermission": false
        }
      ],
      [
        "./plugins/withAndroidPackageVisibility",
        {
          "schemes": [
