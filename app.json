{
  "expo": {
    "name": "NORMA",
    "slug": "norma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "scheme": "norma",
    "splash": {
      "image": "./assets/norma-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.norma.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "sportscenter",
          "paramountplus",
          "peacocktv",
          "hbomax",
          "hulu",
          "youtube-tv",
          "fubo",
          "slingtv",
          "directvstream",
          "draftkings",
          "fanduel",
          "betmgm",
          "caesarssportsbook",
          "kalshi",
          "tntdrama",
          "tbs",
          "trutv",
          "cbssports",
          "xfinitystream",
          "spectrumtv"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.norma.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications"
    ],
    "runtimeVersion": "exposdk:54.0.0",
    "updates": {
      "url": "https://u.expo.dev/3a418868-5bb5-4852-b565-3282ee4fe91e"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3a418868-5bb5-4852-b565-3282ee4fe91e"
      }
    },
    "owner": "d10dave"
  }
}
